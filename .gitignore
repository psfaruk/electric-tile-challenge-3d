# Godot generated files
.godot/
*.import
# The character GLB needs its tuned import settings committed so every
# fresh checkout / CI import keeps all pose-keyed animation channels:
!assets/characters/human/human_male.glb.import
# v3: texture import settings are pinned per texture ROLE (albedo = sRGB
# VRAM, normal = linear/normal-encoded, ORM = channel-packed linear, all
# with mipmaps). Without these, a fresh CI import defaults to lossless +
# mip-less 2K photoscans (huge VRAM + aliasing). See scripts-dev/probe_textures.gd.
!assets/textures/**/*.import
# Embedded textures re-extracted by the glTF importer on every fresh import:
assets/characters/human/human_male_*.png

# Build output
build/
*.apk
*.aab

# OS / python
.DS_Store
*.pyc
__pycache__/

# Signing material that must never be regenerated by tools:
# (the demo keystore IS committed intentionally - see docs/ANDROID_BUILD.md)
